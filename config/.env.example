# CNTXT Environment Variables

# Anthropic API key (required for embeddings)
ANTHROPIC_API_KEY=your_key_here

# Path to CNTXT config file (default: config/config.yaml)
CNTXT_CONFIG=config/config.yaml

# Google Drive OAuth client secrets (if using Google Drive)
GOOGLE_APPLICATION_CREDENTIALS=config/gdrive_credentials.json

# Override server host/port
CNTXT_HOST=127.0.0.1
CNTXT_PORT=8765
